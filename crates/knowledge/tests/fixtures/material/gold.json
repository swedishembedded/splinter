{
 "schema": "material-gold/1",
 "note": "The fixture corpus's expected objects, in pack form: what the scripted proposer states, which a careful reader would also extract (superseded and conflicting statements included).",
 "objects": [
  {
   "id": "terminate-late",
   "kind": "threshold",
   "document": "supply-act-delay",
   "quote": "If the seller delivers more than 14 days after the agreed date, the buyer may terminate the contract by written notice.",
   "data": {
    "var": "days_late",
    "op": ">",
    "value": 14,
    "outcome": "may_terminate",
    "label": "days of delay",
    "vars": {
     "days_late": "int"
    }
   }
  },
  {
   "id": "notice-window",
   "kind": "deadline",
   "document": "supply-act-delay",
   "quote": "The buyer must give the notice within 30 days after the delay became known.",
   "data": {
    "event": "notice_deadline",
    "from": "delay_known_date",
    "offset": 30,
    "unit": "calendar_days",
    "vars": {
     "delay_known_date": "date"
    }
   }
  },
  {
   "id": "delay-penalty",
   "kind": "computation",
   "document": "supply-act-delay",
   "quote": "For each day of delay the buyer may claim a penalty of 0.5 percent of the price, but at most 10 percent of the price.",
   "data": {
    "name": "penalty",
    "when": {
     "var": "days_late",
     "op": ">",
     "value": 0
    },
    "expr": [
     "pct",
     [
      "var",
      "price"
     ],
     [
      "min",
      [
       "mul",
       [
        "var",
        "days_late"
       ],
       [
        "const",
        "0.5"
       ]
      ],
      [
       "const",
       "10"
      ]
     ]
    ],
    "vars": {
     "days_late": "int",
     "price": "number"
    }
   }
  },
  {
   "id": "buyer-caused",
   "kind": "exception",
   "document": "supply-act-delay",
   "quote": "The right to terminate does not apply if the delay was caused by the buyer.",
   "data": {
    "overrides": "terminate-late",
    "when": {
     "var": "caused_by_buyer",
     "op": "==",
     "value": true
    },
    "outcome": "no_right",
    "vars": {
     "caused_by_buyer": "bool"
    }
   }
  },
  {
   "id": "examine-goods",
   "kind": "deadline",
   "document": "supply-act-defects",
   "quote": "The buyer must examine the goods within 8 days after delivery.",
   "data": {
    "event": "examination_deadline",
    "from": "delivery_date",
    "offset": 8,
    "unit": "calendar_days",
    "vars": {
     "delivery_date": "date"
    }
   }
  },
  {
   "id": "complaint-window",
   "kind": "deadline",
   "document": "supply-act-defects",
   "quote": "A complaint about a defect must be made within 60 days after delivery.",
   "data": {
    "event": "complaint_deadline",
    "from": "delivery_date",
    "offset": 60,
    "unit": "calendar_days",
    "vars": {
     "delivery_date": "date"
    }
   }
  },
  {
   "id": "price-reduction",
   "kind": "rule",
   "document": "supply-act-defects",
   "quote": "If the goods are defective the buyer may demand a price reduction of 20 percent of the price.",
   "data": {
    "when": {
     "var": "defective",
     "op": "==",
     "value": true
    },
    "outcome": "price_reduction",
    "vars": {
     "defective": "bool"
    }
   }
  },
  {
   "id": "reduction-amount",
   "kind": "computation",
   "document": "supply-act-defects",
   "quote": "If the goods are defective the buyer may demand a price reduction of 20 percent of the price.",
   "data": {
    "name": "reduction",
    "when": {
     "var": "defective",
     "op": "==",
     "value": true
    },
    "expr": [
     "pct",
     [
      "var",
      "price"
     ],
     [
      "const",
      "20"
     ]
    ],
    "vars": {
     "defective": "bool",
     "price": "number"
    }
   }
  },
  {
   "id": "used-after-defect",
   "kind": "exception",
   "document": "supply-act-defects",
   "quote": "No price reduction is allowed if the goods were used after the defect was found.",
   "data": {
    "overrides": "price-reduction",
    "when": {
     "var": "used_after_defect",
     "op": "==",
     "value": true
    },
    "outcome": "no_remedy",
    "vars": {
     "used_after_defect": "bool"
    }
   }
  },
  {
   "id": "payment-due",
   "kind": "deadline",
   "document": "payment-act",
   "quote": "Payment is due 30 days after the invoice date.",
   "data": {
    "event": "payment_due",
    "from": "invoice_date",
    "offset": 30,
    "unit": "calendar_days",
    "vars": {
     "invoice_date": "date"
    }
   }
  },
  {
   "id": "payment-due-consumer",
   "kind": "deadline",
   "document": "payment-act",
   "quote": "For invoices to consumers payment is due 45 days after the invoice date.",
   "data": {
    "event": "payment_due",
    "from": "invoice_date",
    "offset": 45,
    "unit": "calendar_days",
    "vars": {
     "invoice_date": "date"
    }
   }
  },
  {
   "id": "reminder-window",
   "kind": "deadline",
   "document": "payment-act",
   "quote": "A written reminder must be sent within 10 days after the due date.",
   "data": {
    "event": "reminder_deadline",
    "from": "due_date",
    "offset": 10,
    "unit": "calendar_days",
    "vars": {
     "due_date": "date"
    }
   }
  },
  {
   "id": "late-interest",
   "kind": "computation",
   "document": "payment-act",
   "quote": "Late payment carries interest of 8 percent per year on the amount, counted per day of delay over 365 days, but only after a written reminder has been sent.",
   "data": {
    "name": "interest",
    "when": {
     "all": [
      {
       "var": "days_overdue",
       "op": ">",
       "value": 0
      },
      {
       "var": "reminder_sent",
       "op": "==",
       "value": true
      }
     ]
    },
    "expr": [
     "div",
     [
      "mul",
      [
       "pct",
       [
        "var",
        "amount"
       ],
       [
        "const",
        "8"
       ]
      ],
      [
       "var",
       "days_overdue"
      ]
     ],
     [
      "const",
      "365"
     ]
    ],
    "vars": {
     "days_overdue": "int",
     "reminder_sent": "bool",
     "amount": "number"
    }
   }
  },
  {
   "id": "no-reminder-no-interest",
   "kind": "rule",
   "document": "payment-act",
   "quote": "Late payment carries interest of 8 percent per year on the amount, counted per day of delay over 365 days, but only after a written reminder has been sent.",
   "data": {
    "when": {
     "all": [
      {
       "var": "days_overdue",
       "op": ">",
       "value": 0
      },
      {
       "var": "reminder_sent",
       "op": "==",
       "value": true
      }
     ]
    },
    "outcome": "interest_due",
    "vars": {
     "days_overdue": "int",
     "reminder_sent": "bool"
    }
   }
  },
