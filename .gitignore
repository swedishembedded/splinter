# Generated documentation and its PDF (make docs).
/build/

# Build output, with or without `make deps/local`.
/target/

# Machine-specific cargo overrides written by `make deps/local`: absolute paths to
# local brain and sven checkouts. Never shared.
/.cargo/config.toml

# sven's per-directory session state (audit log, logs, workflows) wherever an
# agent runs in this tree.
.sven/

# Local task tracking and scratch work.
/.todo/
/scratchpad/

# LaTeX intermediates from a latexmk run started inside a paper directory;
# papers/paper.mk builds under target/ so none of these belong in the tree.
/papers/*/*.aux
/papers/*/*.bbl
/papers/*/*.blg
/papers/*/*.fdb_latexmk
/papers/*/*.fls
/papers/*/*.log
/papers/*/*.out

# Python bytecode from the hook and task scripts.
__pycache__/
*.pyc

# Model artifacts never belong in the tree (scripts/gates/check-large-files.sh
# refuses them even when forced past this list).
*.safetensors
*.gguf
*.ckpt
*.pt
*.bin

# Generated output is never committed. The anchor suite is built by
# samples/generations/anchor200.py (`make samples/generations/anchor-200`);
# the flywheel paper keeps the values its claims cite in a hand-checked measurements file,
# never the raw run logs or the tables its build script derives.
/samples/generations/*.jsonl
/papers/splinter-brain-sven-flywheel/data/runs/
/papers/*/generated/
