+/*
+** zero-index dialect: a non-negative position p names the character at
+** offset p (stock position p+1); a negative position keeps the stock
+** meaning (-1 is the last character).  Result is a stock 1-based position.
+*/
+static ptrdiff_t posin (ptrdiff_t pos, size_t len) {
+  if (pos >= 0) return pos + 1;
+  return posrelat(pos, len);
+}
