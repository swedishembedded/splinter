+/*
+** plus-concat dialect: `+' on two strings concatenates them.  The result is
+** built in the shared buffer, as luaV_concat does; no metamethod is tried.
+*/
+static void addstrings (lua_State *L, StkId ra, const TValue *rb,
+                        const TValue *rc) {
+  size_t lb = tsvalue(rb)->len, lc = tsvalue(rc)->len;
+  char *buffer;
+  if (lc >= MAX_SIZET - lb) luaG_runerror(L, "string length overflow");
+  buffer = luaZ_openspace(L, &G(L)->buff, lb + lc);
+  memcpy(buffer, svalue(rb), lb);
+  memcpy(buffer + lb, svalue(rc), lc);
+  setsvalue2s(L, ra, luaS_newlstr(L, buffer, lb + lc));
+}
+
