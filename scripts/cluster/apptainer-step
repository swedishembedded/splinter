# Enter an Apptainer image on a node's host and run a command in it: what a
# Splinter step (a brain server of a fleet, a rank of a job) needs when
# Splinter itself runs in that image, since a step starts on the node's host.
# Name it as the start of --cluster-exec-prefix.
#
# Usage: apptainer-step --image SIF [--bind DIR]... -- command [args...]
#
# The bind variables of the container the step was started from name paths
# of that container, not of the host, so they are dropped, and so is the
# library path it exported. GPUs are passed in (--nv).
set -eu
image="" binds=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --image) image=${2:?--image needs a path}; shift 2 ;;
        --bind) binds="$binds -B ${2:?--bind needs a directory}"; shift 2 ;;
        --) shift; break ;;
        *) echo "apptainer-step: unknown argument: $1" >&2; exit 2 ;;
    esac
done
[ -n "$image" ] && [ "$#" -gt 0 ] || { echo "apptainer-step: usage: apptainer-step --image SIF [--bind DIR]... -- command..." >&2; exit 2; }
unset APPTAINER_BIND SINGULARITY_BIND LD_LIBRARY_PATH
# shellcheck disable=SC2086 # each bind is its own -B word
exec apptainer exec --nv $binds "$image" "$@"
